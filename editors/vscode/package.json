{
  "name": "iguana-vscode",
  "displayName": "Iguana",
  "description": "Language support for iggy grammars",
  "version": "0.1.0",
  "publisher": "iguana-parser",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:iggy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iggy",
        "aliases": [
          "Iggy",
          "iggy"
        ],
        "extensions": [
          ".iggy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iggy",
        "scopeName": "source.iggy",
        "path": "./syntaxes/iggy.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Iguana",
      "properties": {
        "iguana.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the iguana-lsp binary. If empty, looks for 'iguana-lsp' on PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.91.0",
    "typescript": "^7.0.2"
  }
}
