{
  "name": "@iguana-parser/web-viewer",
  "version": "0.1.0",
  "description": "Static web viewer that mounts the shared parse view against a wasm-compiled iguana parser.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/clean-dist.mjs",
    "stage:iggy": "node scripts/stage-iggy-bundle.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node scripts/check-clean-dist.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@iguana-parser/web-ui": "*",
    "@lezer/highlight": "^1.2.5",
    "cytoscape": "^3.33.2",
    "cytoscape-tidytree": "^0.2.1",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
