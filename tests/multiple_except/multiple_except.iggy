grammar MultipleExcept

SyntaxIdentifier = IdentifierChars \ Keyword \ BooleanLiteral \ NullLiteral
LexicalIdentifier = Identifier

@Regex
Identifier = [a-zA-Z]+ \ Keyword \ BooleanLiteral \ NullLiteral

@Regex
IdentifierChars = [a-zA-Z]+

@Regex
Keyword = "if" | "else" | "while" | "for"

@Regex
BooleanLiteral = "true" | "false"

@Regex
NullLiteral = "null"
