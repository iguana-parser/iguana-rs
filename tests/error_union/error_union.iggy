grammar ErrorUnion

@NoLayout
T = "[" BeforeP Layout P Layout "]"
  | "[" BeforeQ Layout Q Layout "]"

// This reversal must report the same union in the same order. Both starts also
// exercise literal-before-name ordering and suppression of WS and Newline.
// The trailing EOF is a start-wrapper artifact that the broader 0.2
// error-reporting work is expected to address.
@NoLayout
U = "[" BeforeQ Layout Q Layout "]"
  | "[" BeforeP Layout P Layout "]"

P = "p" | Word
Q = "q"

BeforeP = "x" | "x" "y"
BeforeQ = "x" | "x" "z"

// Failures of different kinds at the same input index remain first-wins. Which
// kind is first reflects descriptor scheduling, not a semantic precedence rule;
// these cases pin the current behavior rather than promising that order.
@NoLayout
UnexpectedFirst = Identifier \ Keyword
                | Identifier "!"

@NoLayout
ExcludedFirst = Identifier "!"
              | Identifier \ Keyword

// The same pinning, with the unexpected-token failure recorded by the
// prediction check of the call to MissingSuffix. Each pair reverses the
// alternatives to record the two failures in both orders.
@NoLayout
PredictionBeforeExcept = Identifier \ Keyword
                       | Identifier MissingSuffix

@NoLayout
ExceptBeforePrediction = Identifier MissingSuffix
                       | Identifier \ Keyword

@NoLayout
PredictionBeforeFollow = Identifier !>> Question Question
                       | Identifier MissingSuffix

@NoLayout
FollowBeforePrediction = Identifier MissingSuffix
                       | Identifier !>> Question Question

@NoLayout
MissingSuffix = SuffixChoice

@NoLayout
SuffixChoice = "!" | "!" "!"

// A failed call reports the prediction set of the called nonterminal. On `1q`,
// the call to PrefixX expects the terminals that can start PrefixX, "x" and
// "y". The report does not include "w", which follows NullablePrefix only
// inside PrefixW. NullablePrefix has two nonempty alternatives so that the
// parser does not take the LL(1) path for it.
@NoLayout
CallPrediction = "1" PrefixX | "2" PrefixW

@NoLayout
PrefixX = NullablePrefix "x"

@NoLayout
PrefixW = NullablePrefix "w"

@NoLayout
NullablePrefix = "y" | "y" "y" | ()

@Regex
Question = "?"

@Regex
Word = [a-z]+

@Regex
Identifier = [a-zA-Z]+

@Regex
Keyword = "if" | "else" | "while"

@Layout
Layout = (WS | Newline)* !>> WS !>> Newline

@Regex
WS = [\ ]+

@Regex
Newline = [\n]+
