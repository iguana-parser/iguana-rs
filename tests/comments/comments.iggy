grammar Comments

// Expressions
@Start
Expr
  = Expr "+" Expr // addition
  | Expr "*" Expr // multiplication
  | "x" // variable

@Layout @Regex
Layout
  = (WS | Comment)*

// Lexical rules
@Regex
Identifier = [a-zA-Z]+

// Line comments start with //
@Regex
Comment = "//" ![\n]*

// Whitespace
@Regex
WS = [\ \n \t]+
