grammar Comments

// Layout definition
layout Layout

// Expressions
Expr
  = Expr "+" Expr // addition
  | Expr "*" Expr // multiplication
  | "x" // variable

@regex
Layout
  = (WS | Comment)*

// Lexical rules
@regex
Identifier = [a-zA-Z]+

// Line comments start with //
@regex
Comment = "//" ![\n]*

// Whitespace
@regex
WS = [\ \n \t]+
