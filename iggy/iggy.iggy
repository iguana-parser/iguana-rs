grammar Iggy

Grammar
  = ignore_case:"@IgnoreCase"? "grammar" name:Identifier Rule*

Rule
  = SyntaxRule #SyntaxRule
  | RegexRule  #RegexRule

SyntaxRule
  = Annotation? head:Identifier "=" { PriorityLevel ">" }+

Annotation
  = "@NoLayout" #NoLayout
  | "@Layout"   #Layout

RegexRule
  = layout:"@Layout"? id_annot:"@Identifier"? "@Regex" Identifier "="
      RegexPreCondition? body:{ Regex+ "|" }+ RegexPostCondition*

RegexPreCondition
  = RegexOperand "!<<"

RegexPostCondition
  = "\\" RegexOperand  #Except
  | "!>>" RegexOperand #FollowRestriction

RegexOperand
  = CharClass  #CharClass
  | Char       #Char
  | Literal    #Literal
  | Identifier #Identifier

PriorityLevel
  = Associativity? { Alternative "|" }+

Associativity
  = "left"
  | "right"
  | "none"

Alternative
  = Symbol+ Label? #Symbols
  | "(" ")" Label? #Empty

Symbol
  = Identifier                                     #Identifier
  | "(" seqs:{ Symbol+ "|" }+ ")"                  #Paren
  | Literal                                        #Literal
  | "{" symbol:Symbol sep:Symbol "}" "*"           #StarSep
  | "{" symbol:Symbol sep:Symbol "}" "+"           #PlusSep
  > Symbol "*"                                     #Star
  | Symbol "+"                                     #Plus
  | Symbol "?"                                     #Opt
  | Symbol!PostCondition conditions:PostCondition+ #PostCondition
  > conditions:PreCondition+ Symbol!PreCondition   #PreCondition
  > label:Identifier ":" Symbol                    #Labeled

PreCondition
  = Operand "!<<"

PostCondition
  = "\\" Operand   #Except
  | "&" Operand    #Require
  | "!>>" Operand  #FollowRestriction
  | "!>>>" Operand #LayoutAwareFollowRestriction
  | "!" Identifier #Exclude

Operand
  = Identifier #Identifier
  | Literal    #Literal

Regex
  = Regex "+"                    #Plus
  | Regex "*"                    #Star
  | Regex "?"                    #Opt
  | "(" seqs:{ Regex+ "|" }+ ")" #Paren
  | CharClass                    #CharClass
  | Char                         #Char
  | Literal                      #Literal
  | Identifier                   #Identifier

Literal
  = String           #Plain
  | IgnoreCaseString #IgnoreCase
  | ExactString      #Exact

@NoLayout
IgnoreCaseString
  = "i" String

@NoLayout
ExactString
  = "s" String

CharClass
  = neg:"!"? "[" RangeElement+ "]"

RangeElement
  = Range
  | RangeChar

Range
  = start:RangeChar "-" end:RangeChar

@Layout
Layout
  = (WS | LineComment)* !>> WS !>> LineComment

@Regex
Keyword
  = "grammar"
  | "left"
  | "right"
  | "none"
  | "i"
  | "s"

@Regex
NameChar = [a-zA-Z_0-9]

@Regex
Identifier = NameChar !<< [a-zA-Z] [a-zA-Z_0-9]* \ Keyword

@Regex
String = "\"" (EscapeChar | !["\\\r\n])* "\""

@Regex
Char = "'" (EscapeChar | !['\\\r\n]) "'"

@Regex
EscapeChar
  = "\\" ["'\\tfrn]
  | "\\u{" [0-9a-fA-F]+ "}"

@Regex
RangeChar
  = ![\\\-\[\]\t\f\r\n\ ]
  | "\\" [\\\-\[\]tfrn\ ]
  | "\\u{" [0-9a-fA-F]+ "}"

@Regex
Label = "#" [a-zA-Z] [a-zA-Z_0-9]*

@Regex
WS = WSChar+

@Regex
WSChar = [\ \r\n\t]

@Regex
LineComment = "//" ![\r\n]*
