grammar Iggy

@Start
Grammar
  = "grammar" name:Identifier Rule*

Rule
  = SyntaxRule #SyntaxRule
  | RegexRule  #RegexRule

SyntaxRule
  = Annotation? head:Identifier "=" { PriorityLevel ">" }*

Annotation
  = "@NoLayout"                      #NoLayout
  | "@Layout"                        #Layout
  | "@WithLayout" "(" Identifier ")" #WithLayout
  | "@Start"                         #Start

RegexRule
  = layout:"@Layout"? "@Regex" Identifier "=" PreCondition? body:{ Regex+ "|" }+ PostCondition*

PreCondition
  = Identifier "!<<" #PrecedeRestriction

PostCondition
  = "\\" Identifier  #Except
  | "!>>" Identifier #FollowRestriction

PriorityLevel
  = Associativity? { Alternative "|" }*

Associativity
  = "left"
  | "right"
  | "none"

Alternative
  = Symbol+ Label? #Symbols
  | "(" ")" Label? #Empty

Symbol
  = Identifier                                                #Identifier
  | "(" Symbol+ ")"                                           #Group
  | "(" first:Symbol rest:("|" Symbol)+ ")"                   #Alt
  | String                                                    #Lit
  | "{" symbol:Symbol sep:Symbol "}" "*"                      #StarSep
  | "{" symbol:Symbol sep:Symbol "}" "+"                      #PlusSep
  > Symbol "*"                                                #Star
  | Symbol "+"                                                #Plus
  | Symbol "?"                                                #Opt
  | Symbol!Except excepts:("\\" Identifier)+                  #Except
  | Symbol!FollowRestriction restrictions:("!>>" Identifier)+ #FollowRestriction
  | Symbol labels:("!" Identifier)+                           #Exclude
  > Identifier "!<<" Symbol                                   #PrecedeRestriction
  > label:Identifier ":" Symbol                               #Labeled

Regex
  = Regex "+"                             #Plus
  | Regex "*"                             #Star
  | Regex "?"                             #Opt
  | "(" first:Regex rest:("|" Regex)+ ")" #Alt
  | "(" Regex+ ")"                        #Group
  | CharClass                             #CharClass
  | Char                                  #Char
  | String                                #String
  | Identifier                            #Identifier

CharClass
  = neg:"!"? "[" RangeElement+ "]"

RangeElement
  = Range
  | RangeChar

Range
  = start:RangeChar "-" end:RangeChar

@Layout
Layout
  = (WS | LineComment)* !>> WS !>> LineComment

@Regex
Keyword = "grammar" | "left" | "right" | "none"

@Regex
Identifier = [a-zA-Z_] [a-zA-Z_0-9]* \ Keyword

@Regex
String = "\"" (EscapeChar | !["\\])* "\""

@Regex
Char = "'" (EscapeChar | !['\\]) "'"

@Regex
EscapeChar = "\\" ["'\\tfrn]

@Regex
RangeChar = ![\\\-\[\]\t\f\r\n\ ] | "\\" [\\\-\[\]tfrn\ ]

@Regex
Label = "#" [a-zA-Z_] [a-zA-Z_0-9]*

@Regex
WS = WSChar+

@Regex
WSChar = [\ \n\t]

@Regex
LineComment = "//" ![\n]*
