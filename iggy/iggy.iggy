grammar Iggy

layout WS

Grammar
  = "grammar" name:Identifier LayoutDef? SyntaxRule* RegexBlock?

LayoutDef
  = "layout" Identifier*

SyntaxRule
  = Annotation? head:Identifier "=" {PriorityLevel ">"}*

Annotation
  = "@NoLayout"                        #NoLayout
  | "@Layout" "(" Identifier ")"       #Layout

RegexBlock
  = "regex" "{" RegexRule* "}"

RegexRule
  = Identifier "=" body:{ Regex+ "|" }+ PostCondition*

PostCondition
  = "\\" Identifier              #Except
  | "!>>" Identifier             #FollowRestriction

PriorityLevel
  = Associativity? { Alternative "|" }*

Associativity
  = "left"
  | "right"
  | "none"

Alternative
  = Symbol* Label?

Symbol
  = Identifier                               #Identifier
  | "(" Symbol+ ")"                          #Group
  | "(" first:Symbol rest:("|" Symbol)+ ")"  #Alt
  | "\"" String "\""                         #Lit
  | "{" symbol:Symbol sep:Symbol "}" "*"     #StarSep
  | "{" symbol:Symbol sep:Symbol "}" "+"     #PlusSep
  > Symbol "*"                               #Star
  | Symbol "+"                               #Plus
  | Symbol "?"                               #Opt
  | Symbol "\\" Identifier                   #Except
  | Symbol "!>>" Identifier                  #FollowRestriction
  > label:Identifier ":" Symbol              #Labeled

Regex
  = Regex "+"                                 #Plus
  | Regex "*"                                 #Star
  | Regex "?"                                 #Opt
  | "(" first:Regex rest:("|" Regex)+ ")"     #Alt
  | "(" Regex+ ")"                            #Group
  | CharClass                                 #CharClass
  | "'" Char "'"                              #Char
  | "\"" String "\""                          #String

CharClass
  = neg:"!"? "[" RangeElement+ "]"

RangeElement
  = Range
  | RangeChar

Range
  = start:RangeChar "-" end:RangeChar

regex {
  Keyword = "grammar" | "layout" | "regex" | "left" | "right" | "none"
  Identifier = [a-zA-Z_][a-zA-Z_0-9]* \ Keyword
  String = (("\\" [" \\ t f r n]) | !["\\])*

  RangeChar
    = ![\\ \- \[ \] \t \f \r \n \ ]
    | "\\" [\\ \- \[ \] t f r n \ ]

  Char
    = "\\" [' \\ t f r n]
    | !['\\]

  Label = "#" [a-zA-Z_][a-zA-Z_0-9]*
  WS = [\ \n]*
}
