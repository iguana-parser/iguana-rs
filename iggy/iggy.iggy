grammar Iggy

Grammar
  = "grammar" name:Identifier Rule*

Rule
  = SyntaxRule #SyntaxRule
  | RegexRule  #RegexRule

SyntaxRule
  = Annotation? head:Identifier "=" { PriorityLevel ">" }*

Annotation
  = "@NoLayout"                      #NoLayout
  | "@Layout"                        #Layout
  | "@WithLayout" "(" Identifier ")" #WithLayout

RegexRule
  = layout:"@Layout"? id_annot:"@Identifier"? "@Regex" Identifier "="
      RegexPreCondition? body:{ Regex+ "|" }+ RegexPostCondition*

RegexPreCondition
  = Identifier "!<<"

RegexPostCondition
  = "\\" Identifier  #Except
  | "!>>" Identifier #FollowRestriction

PriorityLevel
  = Associativity? { Alternative "|" }*

Associativity
  = "left"
  | "right"
  | "none"

Alternative
  = Symbol+ Label? #Symbols
  | "(" ")" Label? #Empty

Symbol
  = Identifier                                     #Identifier
  | "(" seqs:{ Symbol+ "|" }+ ")"                  #Paren
  | String                                         #Lit
  | "{" symbol:Symbol sep:Symbol "}" "*"           #StarSep
  | "{" symbol:Symbol sep:Symbol "}" "+"           #PlusSep
  > Symbol "*"                                     #Star
  | Symbol "+"                                     #Plus
  | Symbol "?"                                     #Opt
  | Symbol!PostCondition conditions:PostCondition+ #PostCondition
  > conditions:PreCondition+ Symbol!PreCondition   #PreCondition
  > label:Identifier ":" Symbol                    #Labeled

PreCondition
  = Identifier "!<<"

PostCondition
  = "\\" Identifier   #Except
  | "!>>" Identifier  #FollowRestriction
  | "!>>>" Identifier #LayoutAwareFollowRestriction
  | "!" Identifier    #Exclude

Regex
  = Regex "+"                    #Plus
  | Regex "*"                    #Star
  | Regex "?"                    #Opt
  | "(" seqs:{ Regex+ "|" }+ ")" #Paren
  | CharClass                    #CharClass
  | Char                         #Char
  | String                       #String
  | Identifier                   #Identifier

CharClass
  = neg:"!"? "[" RangeElement+ "]"

RangeElement
  = Range
  | RangeChar

Range
  = start:RangeChar "-" end:RangeChar

@Layout
Layout
  = (WS | LineComment)* !>> WS !>> LineComment

@Regex
Keyword
  = "grammar"
  | "left"
  | "right"
  | "none"

@Regex
NameChar = [a-zA-Z_0-9]

@Regex
Identifier = NameChar !<< [a-zA-Z_] [a-zA-Z_0-9]* \ Keyword

@Regex
String = "\"" (EscapeChar | !["\\])* "\""

@Regex
Char = "'" (EscapeChar | !['\\]) "'"

@Regex
EscapeChar = "\\" ["'\\tfrn]

@Regex
RangeChar
  = ![\\\-\[\]\t\f\r\n\ ]
  | "\\" [\\\-\[\]tfrn\ ]

@Regex
Label = "#" [a-zA-Z_] [a-zA-Z_0-9]*

@Regex
WS = WSChar+

@Regex
WSChar = [\ \n\t]

@Regex
LineComment = "//" ![\n]*
