grammar Iggy

layout Layout

@Start
Grammar
  = "grammar" name:Identifier LayoutDef? Rule*

LayoutDef
  = "layout" Identifier

Rule
  = SyntaxRule #SyntaxRule
  | RegexRule  #RegexRule

SyntaxRule
  = Annotation* head:Identifier "=" { PriorityLevel ">" }*

Annotation
  = "@NoLayout"                  #NoLayout
  | "@Layout" "(" Identifier ")" #Layout
  | "@Start"                     #Start

RegexRule
  = "@regex" Identifier "=" PreCondition? body:{ Regex+ "|" }+ PostCondition*

PreCondition
  = Identifier "!<<" #PrecedeRestriction

PostCondition
  = "\\" Identifier  #Except
  | "!>>" Identifier #FollowRestriction

PriorityLevel
  = Associativity? { Alternative "|" }*

Associativity
  = "left"
  | "right"
  | "none"

Alternative
  = Symbol* Label?

Symbol
  = Identifier                                                #Identifier
  | "(" Symbol+ ")"                                           #Group
  | "(" first:Symbol rest:("|" Symbol)+ ")"                   #Alt
  | String                                                    #Lit
  | "{" symbol:Symbol sep:Symbol "}" "*"                      #StarSep
  | "{" symbol:Symbol sep:Symbol "}" "+"                      #PlusSep
  > Symbol "*"                                                #Star
  | Symbol "+"                                                #Plus
  | Symbol "?"                                                #Opt
  | Symbol!Except excepts:("\\" Identifier)+                  #Except
  | Symbol!FollowRestriction restrictions:("!>>" Identifier)+ #FollowRestriction
  | Symbol labels:("!" Identifier)+                           #Exclude
  > Identifier "!<<" Symbol                                   #PrecedeRestriction
  > label:Identifier ":" Symbol                               #Labeled

Regex
  = Regex "+"                             #Plus
  | Regex "*"                             #Star
  | Regex "?"                             #Opt
  | "(" first:Regex rest:("|" Regex)+ ")" #Alt
  | "(" Regex+ ")"                        #Group
  | CharClass                             #CharClass
  | Char                                  #Char
  | String                                #String
  | Identifier                            #Identifier

CharClass
  = neg:"!"? "[" RangeElement+ "]"

RangeElement
  = Range
  | RangeChar

Range
  = start:RangeChar "-" end:RangeChar

@NoLayout
Layout
  = (WS | LineComment)* !>> WS !>> LineComment

@regex
Keyword = "grammar" | "layout" | "left" | "right" | "none"

@regex
Identifier = [a-zA-Z_] [a-zA-Z_0-9]* \ Keyword

@regex
String = "\"" (EscapeChar | !["\\])* "\""

@regex
Char = "'" (EscapeChar | !['\\]) "'"

@regex
EscapeChar = "\\" ["'\\tfrn]

@regex
RangeChar = ![\\\-\[\]\t\f\r\n\ ] | "\\" [\\\-\[\]tfrn\ ]

@regex
Label = "#" [a-zA-Z_] [a-zA-Z_0-9]*

@regex
WS = WSChar+

@regex
WSChar = [\ \n\t]

@regex
LineComment = "//" ![\n]*
